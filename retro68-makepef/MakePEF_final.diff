+        for(unsigned char c : str)
+            hash = (int32_t)((((uint32_t)hash << 1) - (uint32_t)(hash >> 16)) ^ c);
         
         return uint32_t( (str.size() << 16) | ((hash ^ (hash >> 16)) & 0xFFFF) );
     }
 
+    /* CFM's PEFHashTableIndex: (word ^ (word >> power)) & (size-1).
+       Was "key % sz", which only agrees with CFM when power == 0 (< 10 exports). */
+    uint32_t hashIndex(uint32_t key, int sz) const
+    {
+        return (key ^ (key >> power_)) & (uint32_t)(sz - 1);
+    }
